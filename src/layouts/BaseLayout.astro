---
import '@fontsource-variable/nunito';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/logos/logo-api-complet.png' } = Astro.props;
const titreComplet = title === 'Accueil' ? `${site.nom} | Association des Parents Indépendants` : `${title} | ${site.nom}`;
const urlCanonique = new URL(Astro.url.pathname, Astro.site);
const urlImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={urlCanonique} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#c0262d" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlCanonique} />
    <meta property="og:image" content={urlImage} />
  </head>
  <body>
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .lien-evitement {
    position: absolute;
    left: -9999px;
    top: 0.5rem;
    z-index: 100;
    background: var(--rouge);
    color: var(--blanc);
    padding: 0.5rem 1rem;
    border-radius: 999px;
  }

  .lien-evitement:focus {
    left: 0.5rem;
  }
</style>
