---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntetePage from '../components/EntetePage.astro';
import IconeReseau from '../components/IconeReseau.astro';

const partenaires = await getCollection('partenaires');
const reseaux = [
  { id: 'facebook', nom: 'Facebook' },
  { id: 'instagram', nom: 'Instagram' },
  { id: 'linkedin', nom: 'LinkedIn' },
] as const;
const categories = [
  {
    id: 'parents',
    titre: 'Associations de parents',
    intro: "Nous travaillons en bonne intelligence avec les autres associations de parents d'élèves de la ville.",
  },
  {
    id: 'institutions',
    titre: 'Institutions',
    intro: 'La ville et l\'Éducation nationale, nos interlocuteurs au quotidien.',
  },
  {
    id: 'solidarite',
    titre: 'Solidarité',
    intro: 'Des associations que nous soutenons avec les familles, à travers des collectes et des actions dans les écoles.',
  },
] as const;
---

<BaseLayout
  title="Partenariats"
  description="Les partenaires de l'API : PEEP Maisons-Laffitte, la mairie, l'Éducation nationale et des associations solidaires."
>
  <EntetePage
    surtitre="Partenariats"
    titre="Ensemble, on va plus loin"
    intro="L'API agit aux côtés d'autres associations de parents, des institutions et d'associations solidaires."
  />

  <section class="section">
    <div class="conteneur">
      {
        categories.map((categorie) => {
          const liste = partenaires.filter((p) => p.data.categorie === categorie.id);
          return (
            liste.length > 0 && (
              <div class="categorie">
                <h2>{categorie.titre}</h2>
                <p class="categorie__intro">{categorie.intro}</p>
                <div class="grille">
                  {liste.map((p) => (
                    <article class="carte partenaire">
                      <h3>{p.data.nom}</h3>
                      <p>{p.data.description}</p>
                      {(p.data.site || p.data.reseaux) && (
                        <div class="partenaire__liens">
                          {p.data.site && (
                            <a class="partenaire__site" href={p.data.site} rel="noopener" target="_blank">
                              Visiter le site →
                            </a>
                          )}
                          {p.data.reseaux && (
                            <ul class="partenaire__reseaux">
                              {reseaux
                                .filter((r) => p.data.reseaux?.[r.id])
                                .map((r) => (
                                  <li>
                                    <a
                                      href={p.data.reseaux?.[r.id]}
                                      rel="noopener"
                                      target="_blank"
                                      aria-label={`${p.data.nom} sur ${r.nom}`}
                                      title={r.nom}
                                    >
                                      <IconeReseau reseau={r.id} taille={28} couleur />
                                    </a>
                                  </li>
                                ))}
                            </ul>
                          )}
                        </div>
                      )}
                    </article>
                  ))}
                </div>
              </div>
            )
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<style>
  .categorie + .categorie {
    margin-top: 3.5rem;
  }

  .categorie h2 {
    margin-top: 0;
  }

  .categorie__intro {
    color: var(--texte-doux);
    max-width: 60ch;
    margin-bottom: 1.5rem;
  }

  .partenaire {
    display: flex;
    flex-direction: column;
    border-left: 4px solid var(--orange);
  }

  .partenaire p {
    color: var(--texte-doux);
  }

  .partenaire__liens {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
  }

  .partenaire__site {
    font-weight: 700;
  }

  .partenaire__reseaux {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .partenaire__reseaux a {
    display: block;
    border-radius: 6px;
    transition: transform 0.15s;
  }

  .partenaire__reseaux a:hover {
    transform: translateY(-2px);
  }
</style>
