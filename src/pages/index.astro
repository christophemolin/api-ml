---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CartePoint from '../components/CartePoint.astro';
import CarteProjet from '../components/CarteProjet.astro';
import site from '../data/site.json';

const accueil = await getEntry('pages', 'accueil');
if (!accueil) throw new Error('Fichier src/content/pages/accueil.md introuvable');
const { Content } = await render(accueil);

const projets = (await getCollection('projets', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const ecoles = await getCollection('ecoles');
---

<BaseLayout title={accueil.data.title} description={accueil.data.description}>
  <section class="hero">
    <div class="conteneur hero__grille">
      <div class="hero__texte">
        <p class="surtitre">Depuis 1994 à Maisons-Laffitte</p>
        <h1>Des parents engagés pour nos enfants</h1>
        <p class="hero__slogan">{site.slogan}.</p>
        <div class="hero__actions">
          <a class="bouton" href="/nous-rejoindre/">Nous rejoindre</a>
          <a class="bouton bouton--contour" href="/contacts/">Contacter mon école</a>
        </div>
      </div>
      <div class="hero__visuel">
        <img src="/logos/logo-api-complet.png" alt="Logo API, Association des Parents Indépendants" width="1667" height="624" />
        <div class="hero__dessin">
          <img src="/images/illustrations/enfants.svg" alt="Illustration : des enfants jouent au ballon dans la cour, devant leur école" width="700" height="360" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="conteneur presentation">
      <div>
        <p class="surtitre">Qui sommes-nous ?</p>
        <h2>L'Association des Parents Indépendants</h2>
      </div>
      <div class="prose presentation__texte">
        <Content />
      </div>
    </div>
  </section>

  <section class="section section--creme">
    <div class="conteneur">
      <p class="surtitre">Nos missions</p>
      <h2>Représenter les familles et améliorer la vie scolaire</h2>
      <div class="grille grille--4">
        {accueil.data.points.map((point) => <CartePoint {...point} />)}
      </div>
    </div>
  </section>

  {
    accueil.data.valeurs.length > 0 && (
      <section class="section">
        <div class="conteneur">
          <p class="surtitre">Notre charte</p>
          <h2>Nos valeurs, notre engagement</h2>
          <ul class="valeurs">
            {accueil.data.valeurs.map((valeur) => (
              <li class="valeur">
                <strong>{valeur.titre}</strong>
                <span>{valeur.texte}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section section--creme">
    <div class="conteneur">
      <div class="titre-avec-lien">
        <div>
          <p class="surtitre">Nos projets</p>
          <h2>Ce que nous faisons pendant l'année</h2>
        </div>
        <a class="bouton bouton--contour" href="/projets/">Tous les projets</a>
      </div>
      <div class="grille">
        {projets.map((projet) => <CarteProjet projet={projet} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="conteneur bandeau">
      <div>
        <h2>Présents dans {ecoles.length} établissements de la ville</h2>
        <p>Une équipe API dans chaque école et collège, disponible et à l'écoute.</p>
      </div>
      <div class="bandeau__actions">
        <a class="bouton" href="/ecoles/">Voir les écoles</a>
        <a class="bouton bouton--contour" href="/partenariats/">Nos partenaires</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(180deg, var(--creme) 0%, var(--blanc) 100%);
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .hero__grille {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero h1 {
    font-size: clamp(2.1rem, 5vw, 3.3rem);
  }

  .hero__slogan {
    font-size: 1.25rem;
    color: var(--texte-doux);
    max-width: 38ch;
  }

  .hero__actions,
  .bandeau__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .hero__visuel {
    display: grid;
    gap: 1.5rem;
  }

  .hero__dessin {
    width: 85%;
    justify-self: end;
  }

  .presentation {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 2rem;
  }

  .presentation h2 {
    margin-top: 0;
  }

  .presentation__texte {
    font-size: 1.125rem;
  }

  .grille--4 {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    margin-top: 2rem;
  }

  .valeurs {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr));
  }

  .valeur {
    padding: 0.9rem 1.1rem;
    border-radius: 14px;
    background: var(--creme);
    border-left: 4px solid var(--orange);
  }

  .valeur:nth-child(3n + 1) {
    border-left-color: var(--rouge);
  }

  .valeur:nth-child(3n + 2) {
    border-left-color: var(--prune);
  }

  .valeur strong {
    display: block;
    color: var(--texte);
  }

  .valeur span {
    display: block;
    font-size: 0.92rem;
    color: var(--texte-doux);
    line-height: 1.4;
  }

  .titre-avec-lien {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .titre-avec-lien h2 {
    margin-bottom: 0;
  }

  .bandeau {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .bandeau h2 {
    margin-top: 0;
  }

  .bandeau p {
    margin: 0;
    color: var(--texte-doux);
  }

  .bandeau__actions {
    margin-top: 0;
  }

  @media (max-width: 820px) {
    .hero__grille,
    .presentation {
      grid-template-columns: 1fr;
    }

    .hero__dessin {
      width: 100%;
    }
  }
</style>
