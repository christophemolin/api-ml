---
interface Props {
  surtitre?: string;
  titre: string;
  intro?: string;
}

const { surtitre, titre, intro } = Astro.props;
---

<section class="entete-page">
  <div class="conteneur">
    {surtitre && <p class="surtitre">{surtitre}</p>}
    <h1>{titre}</h1>
    {intro && <p>{intro}</p>}
    <slot />
  </div>
</section>
