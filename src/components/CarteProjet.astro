---
import type { CollectionEntry } from 'astro:content';
import { formaterDate } from '../dates';

interface Props {
  projet: CollectionEntry<'projets'>;
}

const { projet } = Astro.props;
const { title, date, summary, image, imageAlt } = projet.data;
---

<article class="carte projet">
  {
    image && (
      <div class="projet__image">
        <img src={image} alt={imageAlt ?? ''} loading="lazy" />
      </div>
    )
  }
  <div class="projet__corps">
    <p class="projet__date"><time datetime={date.toISOString()}>{formaterDate(date)}</time></p>
    <h3><a href={`/projets/${projet.id}/`}>{title}</a></h3>
    <p>{summary}</p>
  </div>
</article>

<style>
  .projet {
    position: relative;
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .projet:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgb(120 40 30 / 0.14);
  }

  .projet__image {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--creme);
    border-bottom: 1px solid var(--bordure);
  }

  .projet__image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0.75rem;
  }

  .projet__corps {
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .projet__date {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--orange);
    margin-bottom: 0.25rem;
  }

  .projet h3 a {
    color: var(--texte);
    text-decoration: none;
  }

  /* toute la carte est cliquable */
  .projet h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .projet h3 a:hover {
    color: var(--rouge);
  }

  .projet p:last-child {
    color: var(--texte-doux);
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .projet {
      transition: none;
    }
  }
</style>
